        "expected": "all lifecycle and real-Git tests pass"
      },
      {
        "id": "full-juno-code",
        "command": "cd juno-code && npm test",
        "expected": "full fast suite passes"
      },
      {
        "id": "typecheck",
        "command": "cd juno-code && npm run typecheck",
        "expected": "exit 0"
      },
      {
