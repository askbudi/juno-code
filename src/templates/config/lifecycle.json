{
  "schema_version": "juno_task_lifecycle_config.v2",
  "default_topology": "root-only",
  "workspace_root": "/private/tmp/juno-code/lifecycle-worktrees",
  "objective_risk": "high",
  "repositories": {
    "root": {
      "path": ".",
      "target_ref": "refs/heads/juno-mono-002",
      "parent": null,
      "expected_paths": [
        ".juno_task/config.json",
        ".juno_task/config/lifecycle.json",
        ".juno_task/scripts/task_lifecycle.py",
        ".juno_task/scripts/tests/test_task_lifecycle.py",
        ".juno_task/wiki/git_worktree_lifecycle.md",
        "README.md",
        "juno-code/README.md",
        "juno-code/src/bin/cli.ts",
        "juno-code/src/core/config.ts",
        "juno-code/src/types/index.ts",
        "juno-code/src/templates/scripts/task_lifecycle.py",
        "juno-code/src/templates/scripts/tests/test_task_lifecycle.py",
        "juno-code/src/templates/wiki/git_worktree_lifecycle.md"
      ]
    },
    "kanban": {
      "path": "juno_kanban",
      "target_ref": "refs/heads/master",
      "parent": "root",
      "mount_path": "juno_kanban",
      "expected_paths": [
        "README.md"
      ]
    }
  },
  "topologies": {
    "root-only": {
      "root": "root",
      "children": []
    },
    "root-with-kanban": {
      "root": "root",
      "children": [
        "kanban"
      ]
    }
  },
  "candidate_gate": {
