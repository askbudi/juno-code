{
  "schema_version": "juno_bolt_risk_policy.v1",
  "tiers": ["low", "normal", "high", "release"],
  "low_risk_paths": [
    "docs/**",
    "*.md",
    "*.mdx",
    "*.txt",
    "**/*.md",
    "**/*.mdx",
    "**/*.txt"
  ],
  "high_risk_paths": [
    ".github/workflows/**",
    "auth/**",
    "security/**",
    "migrations/**",
    "concurrency/**",
    "**/auth/**",
    "**/security/**",
    "**/migrations/**",
    "**/concurrency/**",
    "auth.*",
    "authentication.*",
    "authorization.*",
    "security.*",
    "permissions.*",
    "credentials.*",
    "secrets.*",
    "oauth.*",
    "jwt.*",
    "**/auth.*",
    "**/authentication.*",
    "**/authorization.*",
    "**/security.*",
    "**/permissions.*",
    "**/credentials.*",
    "**/secrets.*",
    "**/oauth.*",
    "**/jwt.*",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "uv.lock",
    "poetry.lock",
    "Cargo.lock",
    "Gemfile.lock",
    "Pipfile.lock",
    "composer.lock",
    "bun.lock",
    "bun.lockb",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/uv.lock",
    "**/poetry.lock",
    "**/Cargo.lock",
    "**/Gemfile.lock",
    "**/Pipfile.lock",
    "**/composer.lock",
    "**/bun.lock",
    "**/bun.lockb"
  ],
  "shared_infrastructure_paths": [
    ".github/workflows/**",
    "package.json",
    "pyproject.toml",
    "tsconfig.json",
    "Cargo.toml",
    "**/package.json",
    "**/pyproject.toml",
    "**/tsconfig.json",
    "**/build.gradle*",
    "**/Cargo.toml"
  ],
  "high_risk_flags": [
    "concurrency",
    "data_migration",
    "destructive",
    "security"
  ],
  "release_flags": ["publish", "release"],
  "review_policy": {
    "low": {"sequence": [], "min": 0, "max": 0},
    "normal": {"sequence": ["reviewer"], "min": 0, "max": 1},
    "high": {"sequence": ["reviewer_a", "reviewer_b"], "min": 2, "max": 2},
    "release": {"sequence": [], "min": 0, "max": 0}
  },
  "full_suite_tiers": ["high", "release"],
  "post_cas_checks": ["target_ref_identity", "tree_identity", "bounded_smoke"],
  "limits": {
    "max_changed_paths": 4096,
    "max_metrics": 16,
    "max_receipt_bytes": 65536,
    "max_string_bytes": 512
  }
}
